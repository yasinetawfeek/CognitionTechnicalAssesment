// Internal Tools Kernel — data model.
//
// Kernel tables are prefixed with nothing (User, Role, ...). App-owned tables
// should be prefixed with the app id (e.g. `KycCase`, `PlaygroundRecord`) so
// ownership is obvious.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  provider     String   @default("password") // "password" | "oidc"
  externalId   String? // subject id from the OIDC provider
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  approvalsMade ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDone ApprovalRequest[] @relation("ApprovalDecider")
  appInstalls   AppInstall[]
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "admin", "kyc_reviewer"
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId     String
  permission String // "kernel.users.manage", "kyc.case.approve", "kyc.*", "*"
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String   @id // sha256 of the cookie token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit log — append-only, hash chained
// ---------------------------------------------------------------------------

model AuditLog {
  seq        Int      @id @default(autoincrement())
  ts         DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // denormalised so the log survives user deletion
  appId      String // "kernel" or an app id
  action     String // "user.create", "kyc.case.approve" ...
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  prevHash   String
  hash       String

  @@index([appId, ts])
  @@index([targetType, targetId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Event bus — persisted events + outbound webhooks
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(cuid())
  type          String // "flag.updated", "kyc.case.decided"
  sourceAppId   String
  actorId       String?
  correlationId String?
  payload       Json
  createdAt     DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([type, createdAt])
  @@index([createdAt])
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  name       String
  url        String
  eventTypes String // comma separated patterns, e.g. "flag.*,kyc.case.decided"
  secret     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status         String              @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts       Int                 @default(0)
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime            @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Notifications, approvals, feature flags, jobs, settings
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  href      String?
  appId     String    @default("kernel")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ApprovalRequest {
  id                 String    @id @default(cuid())
  appId              String
  type               String // handler key, e.g. "kyc.case.decision"
  title              String
  description        String    @default("")
  payload            Json
  requiredPermission String // permission a decider must hold
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedById      String
  requestedBy        User      @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedById        String?
  decidedBy          User?     @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([status, createdAt])
  @@index([appId, status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String   @default("")
  enabled     Boolean  @default(false)
  // Optional targeting rules, evaluated in order. Shape:
  // { "roles": ["kyc_supervisor"], "users": ["email"], "percentage": 25 }
  rules       Json?
  ownerAppId  String   @default("kernel")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([type, createdAt])
}

model AppSetting {
  appId     String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([appId, key])
}

// ---------------------------------------------------------------------------
// App Builder (kernel): user-requested apps built by an AI agent, admin-reviewed
// ---------------------------------------------------------------------------

/// A user's request for a new app, built by an AI coding agent (Devin) and gated by admin review.
model AppRequest {
  id            String    @id @default(cuid())
  appId         String    @unique // future manifest id / route prefix
  name          String
  purpose       String
  requirements  String
  status        String    @default("QUEUED") // QUEUED | BUILDING | READY_FOR_TESTING | IN_REVIEW | PUBLISHED | REJECTED | FAILED
  requestedById String
  // Filled in by the builder adapter (mocked for the PoC)
  sessionId     String?
  sessionUrl    String?
  branch        String?
  prUrl         String?
  previewUrl    String?
  buildLog      Json      @default("[]") // [{ at, step, detail }]
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Example app-owned table (Playground app)
// ---------------------------------------------------------------------------

/// An app a user added to "My apps" from the App Store. Access is still governed by RBAC.
model AppInstall {
  userId      String
  appId       String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installedAt DateTime @default(now())

  @@id([userId, appId])
}

model PlaygroundRecord {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  status      String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  riskScore   Float? // written by the demo "ML" background job
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Financial deadline tracker (Deadlines app)
// ---------------------------------------------------------------------------

model FinanceDeadline {
  id          String   @id @default(cuid())
  reference   String   @unique // "FD-2026-014"
  title       String
  description String   @default("")
  category    String // REGULATORY | TAX | AUDIT | BOARD | CLIENT | INTERNAL
  entity      String   @default("") // legal entity / desk the deadline belongs to
  dueAt       DateTime
  status      String   @default("OPEN") // OPEN | COMPLETED | CANCELLED
  ownerId     String
  createdById String

  // Visibility: EVERYONE (all users with deadlines.access) | ROLES | USERS.
  // `visibleRoles` / `visibleUsers` are pipe-delimited lists ("|admin|treasury|") so SQLite can
  // filter them with a `contains` query; see src/apps/deadlines/visibility.ts.
  visibility   String @default("EVERYONE")
  visibleRoles String @default("")
  visibleUsers String @default("")

  /// Last reminder stage notified for this deadline: T14 | T7 | T1 | OVERDUE.
  lastReminderStage String?
  lastRemindedAt    DateTime?

  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// KYC Review app
// ---------------------------------------------------------------------------

model KycCase {
  id                String    @id @default(cuid())
  reference         String    @unique // human-friendly, e.g. "KYC-0042"
  applicantName     String
  email             String
  country           String // ISO 3166-1 alpha-2
  dateOfBirth       DateTime
  documentType      String // PASSPORT | NATIONAL_ID | DRIVING_LICENCE
  documentNumber    String
  declaredIncome    Float // annual, in account currency
  initialDeposit    Float
  pepMatch          Boolean   @default(false)
  sanctionsHit      Boolean   @default(false)
  status            String    @default("NEW") // NEW | IN_REVIEW | ESCALATED | PENDING_APPROVAL | APPROVED | REJECTED
  riskScore         Float? // 0..1, written by the kyc.score-case job
  riskLevel         String? // LOW | MEDIUM | HIGH
  riskFactors       Json? // [{ factor, weight, detail }]
  scoredAt          DateTime?
  assignedToId      String?
  decision          String? // APPROVE | REJECT
  decisionNote      String?
  decidedById       String? // null when auto-decided by the system
  decidedAt         DateTime?
  approvalRequestId String? // open four-eyes request while PENDING_APPROVAL
  submittedAt       DateTime  @default(now())
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  notes KycCaseNote[]

  @@index([status, submittedAt])
  @@index([assignedToId, status])
  @@index([riskLevel])
}

model KycCaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      KycCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}
